# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma (direct connection for migrations)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# Gemini
GEMINI_API_KEY=your-gemini-key
LEGACY_PUBLIC_GEMINI_FETCH_ENABLED=false

# Google Places
GOOGLE_PLACES_API_KEY=your-google-places-key

# Trails acquisition
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
IGN_API_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Resend
RESEND_API_KEY=re_...

# DATAtourisme (flux territoire Haute-Savoie, type Fête et manifestation)
# Format: https://diffuseur.datatourisme.fr/webservice/<FLUX_ID>/<API_KEY>
DATATOURISME_FLUX_URL=
