# Site (domaine public — canonical, sitemap, OG, JSON-LD, liens QR / reset)
# Hôte canonique = www. L'apex mystay.city doit être redirigé (301) vers www côté hébergeur.
NEXT_PUBLIC_BASE_URL=https://www.mystay.city

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma (direct connection for migrations)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# Gemini
GEMINI_API_KEY=your-gemini-key
LEGACY_PUBLIC_GEMINI_FETCH_ENABLED=false

# Google Places
GOOGLE_PLACES_API_KEY=your-google-places-key

# Trails acquisition
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
IGN_API_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Resend
RESEND_API_KEY=re_...

# DATAtourisme API REST v1 — clé X-API-Key (https://info.datatourisme.fr/utiliser-les-donnees)
DATATOURISME_API_KEY=

# Admin analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_PROPERTY_ID=
GSC_SITE_URL=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
VERCEL_ANALYTICS_PROJECT_ID=
VERCEL_ANALYTICS_DRAIN_SECRET=change-me
VERCEL_ANALYTICS_LIVE_ENDPOINT=https://mystay.city/api/internal/analytics/vercel-live
VERCEL_ANALYTICS_LIVE_TOKEN=change-me
INTERNAL_API_SECRET=change-me
